# Browser-safe Supabase configuration for the Kept frontend.
#
# Only these two values may ever reach client code (docs/supabaseArchitecture.md §7,
# docs/securityAndService.md §48, §50). The service-role / secret key must never be
# added to this file or to any VITE_* variable — anything prefixed VITE_ is inlined
# into the browser bundle.
#
# Copy this file to `WebsitePages/.env` and fill in the real values from the
# Supabase dashboard (Project Settings → API).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
